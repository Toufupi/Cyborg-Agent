{
  "name": "cyborg-agent",
  "version": "0.1.0",
  "description": "Reference tool registry and orchestration experiments for A2C2A-based Cyborg Agents.",
  "type": "module",
  "bin": {
    "cyborg": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli/index.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cyborg": "tsx src/cli/index.tsx"
  },
  "keywords": [
    "a2c2a",
    "agent",
    "tool-registry",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "cli-spinners": "^3.4.0",
    "commander": "^14.0.2",
    "ink": "^7.0.1",
    "ink-text-input": "^6.0.0",
    "log-symbols": "^7.0.1",
    "nanoid": "^5.1.9",
    "react": "^19.2.5",
    "string-width": "^8.2.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.10.2",
    "@types/react": "^19.2.14",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
